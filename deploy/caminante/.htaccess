# ============================================
# caminante/.htaccess — privacidad de las capturas
# ============================================
# Las carpetas de captura guardan `datos.txt` (nota, GPS, dirección) y el registro de subidas
# guarda IP y dispositivo. NADA de eso debe poder descargarse desde el navegador: se sirve
# bloqueado (el sitio los lee por disco, no por HTTP, así que bloquearlos no rompe nada).
<FilesMatch "\.(log|jsonl|txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
