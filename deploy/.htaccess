RewriteRule ^categoria/casas_de_cambio_digital/?$ /categoria/bancos-agentes-y-pagos [R=301,L]
RewriteRule ^categoria/fintech_y_billeteras_digitales/?$ /categoria/bancos-agentes-y-pagos [R=301,L]
RewriteRule ^categoria/prestamos-y-financiamiento/?$ /categoria/bancos-agentes-y-pagos [R=301,L]
RewriteRule ^categoria/locutorios-y-pagos/?$ /categoria/bancos-agentes-y-pagos [R=301,L]
RewriteRule ^categoria/puntos-de-pago-hidrandina/?$ /categoria/bancos-agentes-y-pagos [R=301,L]
RewriteRule ^categoria/contabilidad-y-tramites/?$ /categoria/abogados [R=301,L]
RewriteRule ^categoria/juzgados-y-tramites/?$ /categoria/abogados [R=301,L]
RewriteRule ^categoria/colegios-e-institutos/?$ /categoria/educacion [R=301,L]
RewriteRule ^categoria/cursos-y-talleres/?$ /categoria/educacion [R=301,L]
RewriteRule ^categoria/manejo/?$ /categoria/educacion [R=301,L]
RewriteRule ^categoria/mudanzas-y-fletes/?$ /categoria/transporte [R=301,L]
RewriteRule ^categoria/encomiendas-y-carga/?$ /categoria/transporte [R=301,L]
RewriteRule ^categoria/transporte-interprovincial/?$ /categoria/transporte [R=301,L]
RewriteRule ^categoria/lavado-de-autos/?$ /categoria/lavanderias [R=301,L]
RewriteRule ^categoria/limpieza/?$ /categoria/lavanderias [R=301,L]
RewriteRule ^categoria/estampados-y-sublimados/?$ /categoria/imprentas-y-publicidad [R=301,L]
