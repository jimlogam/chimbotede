RewriteRule ^categoria/coworking/?$ /categoria/habitaciones [R=301,L]
RewriteRule ^categoria/hospedajes-y-cuartos/?$ /categoria/habitaciones [R=301,L]
RewriteRule ^categoria/alquiler-de-habitaciones/?$ /categoria/habitaciones [R=301,L]
