RewriteRule ^categoria/tiendas_de_vapeadores/?$ /categoria/personalizados [R=301,L]
RewriteRule ^categoria/florerias-y-regalos/?$ /categoria/personalizados [R=301,L]
RewriteRule ^categoria/estudios_de_tatuajes/?$ /categoria/personalizados [R=301,L]
