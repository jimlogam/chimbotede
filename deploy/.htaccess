# ============================================
# Chimbote al Día — .htaccess raíz
# URLs amigables + seguridad (según guía §12)
# ============================================
Options -Indexes
AddDefaultCharset UTF-8

RewriteEngine On

# 1) Forzar HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://dechimbote.com/$1 [R=301,L]

# 2) www -> sin www (SEO)
RewriteCond %{HTTP_HOST} ^www\.dechimbote\.com$ [NC]
RewriteRule ^(.*)$ https://dechimbote.com/$1 [R=301,L]

# 3) URLs amigables (soporta guion bajo, lección del proyecto anterior)
#    Fichas de negocio ahora en /neg/<slug>
# Fichas unificadas (mismo establecimiento = una sola URL): ESSALUD Coishco
RewriteRule ^neg/seguro-social-coishco/?$ /neg/essalud-coishco [R=301,L]
# Plazas de Santa: "Plaza Mayor De Santa" (id 1032) era la MISMA plaza que "Plaza de Armas de
# Santa" (id 1569, a ~90 m): se unificaron el 2026-09-10 (fotos y opiniones pasaron a la 1569 y
# la 1032 quedó inactiva), así que la URL vieja redirige para no dejar un 404 en los enlaces.
RewriteRule ^neg/plaza-mayor-de-santa/?$ /neg/plaza-de-armas-de-santa [R=301,L]
RewriteRule ^neg/([a-z0-9_\-]+)/?$ negocio.php?slug=$1 [L,QSA]
# 🚪 LA MISMA FICHA POR NÚMERO (2026-09-18 — pedido del jefe: «no quiero perder las URLs amigables…
#    solo quiero tener una puerta trasera para ingresar a ver el sitio»).
#    · /neg/1875  → ya lo captura la regla de arriba (su patrón admite números): negocio.php ve que el
#      slug es solo dígitos, busca por id y responde **301 a /neg/<slug>**. Por eso NO hace falta una
#      regla nueva para /neg/.
#    · /gen/1875  → es el atajo corto que pidió el jefe (su ejemplo era /gen/1234): esta regla.
#    En los dos casos la respuesta es un **301 a la dirección amigable**, que sigue siendo la única
#    oficial (canonical, sitemap.xml y enlaces compartidos no cambian) y Google nunca ve dos
#    direcciones sirviendo el mismo contenido.
RewriteRule ^gen/([0-9]+)/?$ negocio.php?id=$1 [L,QSA]
# 🛒 LA PÁGINA DE UN PRODUCTO (2026-09-15, pedido del jefe: «que el producto se comparta con su
#    enlace y su foto»). Antes el producto NO tenía dirección propia (su tarjeta abría la ficha
#    rápida dentro de la tienda) y por eso no se podía compartir. Ahora: /producto/<id>.
#    El id es SOLO número, así que no choca con ninguna otra ruta del sitio.
RewriteRule ^producto/([0-9]+)/?$ producto.php?id=$1 [L,QSA]
# Redirección 301 de las URLs viejas /negocio/... a /neg/... (SEO / no romper enlaces)
RewriteCond %{THE_REQUEST} \s/+negocio/([a-z0-9_\-]+)
RewriteRule ^ /neg/%1 [R=301,L]
# ============================================================================
# 🏷️ REDIRECCIONES DE LOS RUBROS REORGANIZADOS (2026-09-19, pedido del jefe)
#    El jefe unificó 124 rubros en ~40 más abiertos: los rubros que se fusionaron y los
#    que cambiaron de nombre APAGAN su dirección vieja. Estas reglas la llevan a la nueva
#    (301 = definitivo), así no se rompe ni un enlace repartido ni lo que ya conoce Google.
#    ⚠️ VAN ANTES de la regla general `^categoria/([a-z0-9_-]+)` (que es la que resuelve
#       /categoria/<slug> de verdad): si se movieran debajo, no se aplicarían nunca.
# ============================================================================
# 🏷️ Rubros que se ELIMINARON sin destino (2026-09-19): su dirección vieja lleva al índice
#    de rubros (/rubros) en vez de dejar un 404 al visitante (Bomberos, Reciclaje…).
RewriteRule ^categoria/bomberos-y-emergencias/?$ /rubros [R=301,L]
RewriteRule ^categoria/reciclaje-y-chatarra/?$ /rubros [R=301,L]
RewriteRule ^categoria/cevicherias/?$ /categoria/restaurantes [R=301,L]
RewriteRule ^categoria/pollerias/?$ /categoria/restaurantes [R=301,L]
RewriteRule ^categoria/chifas/?$ /categoria/restaurantes [R=301,L]
RewriteRule ^categoria/heladerias-y-juguerias/?$ /categoria/restaurantes [R=301,L]
RewriteRule ^categoria/dark_kitchens/?$ /categoria/restaurantes [R=301,L]
RewriteRule ^categoria/comida-al-paso-y-ambulante/?$ /categoria/restaurantes [R=301,L]
RewriteRule ^categoria/menus-y-bodegones/?$ /categoria/restaurantes [R=301,L]
RewriteRule ^categoria/restaurantes-campestres/?$ /categoria/restaurantes [R=301,L]
RewriteRule ^categoria/supermercados/?$ /categoria/bodegas [R=301,L]
RewriteRule ^categoria/tiendas_veganas/?$ /categoria/bodegas [R=301,L]
RewriteRule ^categoria/pastelerias-y-tortas/?$ /categoria/panaderias [R=301,L]
RewriteRule ^categoria/panaderias-y-pastelerias/?$ /categoria/panaderias [R=301,L]
RewriteRule ^categoria/dentistas/?$ /categoria/medicos [R=301,L]
RewriteRule ^categoria/podologos/?$ /categoria/medicos [R=301,L]
