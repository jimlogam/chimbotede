RewriteRule ^categoria/construccion-y-remodelaciones/?$ /categoria/ferreterias [R=301,L]
RewriteRule ^categoria/vidrierias-y-aluminio/?$ /categoria/ferreterias [R=301,L]
RewriteRule ^categoria/cerrajeria/?$ /categoria/ferreterias [R=301,L]
RewriteRule ^categoria/electricistas/?$ /categoria/ferreterias [R=301,L]
RewriteRule ^categoria/ferreterias-y-materiales/?$ /categoria/ferreterias [R=301,L]
RewriteRule ^categoria/gasfiteros/?$ /categoria/ferreterias [R=301,L]
