RewriteRule ^categoria/centros_de_bienestar_holistico/?$ /categoria/terapias [R=301,L]
RewriteRule ^categoria/veterinarias_24_horas/?$ /categoria/veterinarias [R=301,L]
RewriteRule ^categoria/spa_para_mascotas/?$ /categoria/veterinarias [R=301,L]
RewriteRule ^categoria/barberias/?$ /categoria/peluquerias [R=301,L]
RewriteRule ^categoria/extensiones-y-pelucas/?$ /categoria/peluquerias [R=301,L]
RewriteRule ^categoria/maquillaje-profesional/?$ /categoria/belleza [R=301,L]
RewriteRule ^categoria/perfumerias-y-cosmeticos/?$ /categoria/belleza [R=301,L]
