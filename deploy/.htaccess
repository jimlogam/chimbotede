RewriteRule ^categoria/venta-de-motos/?$ /categoria/vehiculos [R=301,L]
RewriteRule ^categoria/venta-de-vehiculos/?$ /categoria/vehiculos [R=301,L]
RewriteRule ^categoria/motos-scooters-y-bicicletas/?$ /categoria/vehiculos [R=301,L]
